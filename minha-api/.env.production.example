# ============================================
# Variáveis de Produção — Juridico API (Docker)
# ============================================
# Copie para .env na pasta minha-api/ antes de docker compose up.
# Veja DEPLOY-DOCKER.md
# ============================================

NODE_ENV=production
PORT=3000

# -------- Banco (docker-compose) --------
DATABASE_URL=postgres://postgres:postgres@postgres:5432/juridico
DB_DIALECT=postgres
# DATABASE_SSL=false  # true apenas se o Postgres exigir SSL

# -------- Redis (docker-compose) --------
REDIS_URL=redis://redis:6379

# -------- Autenticação --------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h

# -------- CORS --------
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# -------- DataJud API --------
DATAJUD_API_KEY=
DATAJUD_MOCK=false
DATAJUD_USE_LEGACY=false

# -------- Legacy Scrapers (opcional) --------
TWOCAPTCHA_API_KEY=
TJSP_API_KEY=
TJMG_API_KEY=

# -------- Logging --------
LOG_LEVEL=warn
