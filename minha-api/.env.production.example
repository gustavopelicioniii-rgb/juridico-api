# ============================================
# Variáveis de Produção — Juridico API
# ============================================
# Copie para .env e preencha os valores.
# No Render, configure-as em "Environment" do serviço.
# ============================================

NODE_ENV=production
PORT=3000

# -------- Banco de dados --------
# Exemplo Render Postgres:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=juridico_api
DB_USER=postgres
DB_PASSWORD=
# DB_STORAGE=./data/database.sqlite  # SQLite (desenvolvimento apenas)

# -------- Redis --------
# Exemplo Render Redis:
# REDIS_URL=redis://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------- Autenticação --------
JWT_SECRET= # Gere: openssl rand -hex 32
JWT_REFRESH_SECRET= # Gere: openssl rand -hex 32
JWT_EXPIRES_IN=1h

# -------- CORS --------
# URLs separadas por vírgula (sem barra no final)
CORS_ORIGIN=https://juridico-frontend.vercel.app

# -------- DataJud API --------
# Registre-se em: https://www.cnj.jus.br/sistemas/datajud/api-publica/
DATAJUD_API_KEY=
DATAJUD_MOCK=false
DATAJUD_USE_LEGACY=false

# -------- Legacy Scrapers (opcional) --------
TWOCAPTCHA_API_KEY=
TJSP_API_KEY=
TJMG_API_KEY=

# -------- Logging --------
LOG_LEVEL=warn
