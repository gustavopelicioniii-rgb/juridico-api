# ============================================
# VariÃ¡veis de ProduÃ§Ã£o â€” Juridico API (Docker)
# ============================================
# Copie para .env na pasta minha-api/ antes de docker compose up.
# Veja DEPLOY-DOCKER.md
# ============================================

NODE_ENV=production
PORT=3000

# -------- Banco (docker-compose) --------
DATABASE_URL=postgres://postgres:postgres@postgres:5432/juridico
DB_DIALECT=postgres
# DATABASE_SSL=false  # true apenas se o Postgres exigir SSL

# -------- Redis (docker-compose) --------
REDIS_URL=redis://redis:6379

# -------- AutenticaÃ§Ã£o --------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h

# -------- CORS --------
# Inclua a URL pÃºblica do dashboard na Vercel.
CORS_ORIGIN=https://seu-dashboard.vercel.app

# -------- DataJud API --------
DATAJUD_API_KEY=
DATAJUD_MOCK=false
DATAJUD_STARTUP_SMOKE_CHECK=true
DATAJUD_USE_LEGACY=false

# -------- Legacy Scrapers (opcional) --------
TWOCAPTCHA_API_KEY=
TJSP_API_KEY=
TJMG_API_KEY=

# -------- Logging --------
LOG_LEVEL=warn

# -------- Topologia API/Worker --------
# API: false | Worker: true
ENABLE_MONITORING=false
ENABLE_OAB_MONITORING=false
MONITORING_DISTRIBUTED_LOCK=true

# -------- Rate limit por conta --------
ACCOUNT_RATE_LIMIT_WINDOW_SECONDS=60
ACCOUNT_RATE_LIMIT_FREE=120
ACCOUNT_RATE_LIMIT_PRO=600
ACCOUNT_RATE_LIMIT_ADMIN=2000

