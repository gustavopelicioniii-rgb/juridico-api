# Environment Configuration Example
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database - Development (SQLite)
DB_DIALECT=sqlite
DB_STORAGE=./data/database.sqlite

# Database - Production (PostgreSQL)
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=juridico_api
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Use this instead of host/port/password when using managed Redis
# REDIS_URL=redis://default:password@host:port

# Monitoramento de movimentaÃ§Ãµes
# Poll interno verifica jobs vencidos; cada processo Ã© consultado uma vez por dia por padrÃ£o
ENABLE_MONITORING=true
MONITORING_INTERVAL_MS=300000
PROCESSO_MONITORING_INTERVAL_MINUTES=1440
ENABLE_OAB_MONITORING=true

# CORS - origens permitidas separadas por vÃ­rgula
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT Authentication (OBRIGATÃ“RIO em produÃ§Ã£o)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-different-refresh-secret-change-in-production
JWT_EXPIRES_IN=1h

# UsuÃ¡rio admin inicial (opcional â€” dev/local)
# Se definidos, cria/atualiza advogado admin no startup e no npm run seed
ADMIN_OAB=SP123456
ADMIN_PASSWORD=change-me-in-production
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com

# DataJud API (CNJ - oficial)
# Registre-se em: https://www.cnj.jus.br/sistemas/datajud/api-publica/
# Em dev sem chave, ativa modo MOCK automaticamente
DATAJUD_API_KEY=
DATAJUD_MOCK=false
DATAJUD_STARTUP_SMOKE_CHECK=true
# Se true, usa adapters legados (scrapers) ao invÃ©s do DataJud
DATAJUD_USE_LEGACY=false

# Firecrawl (opcional - teste isolado de scraping/enriquecimento auxiliar)
FIRECRAWL_ENABLED=false
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_ONLY_MAIN_CONTENT=true
FIRECRAWL_CACHE_TTL_SECONDS=86400
FIRECRAWL_MAX_URLS_PER_JOB=5
FIRECRAWL_MAX_CONTENT_CHARS=12000
FIRECRAWL_TEST_URL=
# Termos separados por virgula para conferir na amostra extraida
FIRECRAWL_TEST_CONTAINS=
FIRECRAWL_TIMEOUT_MS=30000
FIRECRAWL_TEST_OUTPUT=

# 2Captcha (apenas se usar adapters legados com CAPTCHA)
TWOCAPTCHA_API_KEY=

# Tribunal API Keys (legacy adapters - opcional)
TJSP_API_KEY=
TJMG_API_KEY=

# Proxy Rotation (optional)
PROXY_ROTATION_ENABLED=false
PROXY_LIST=[]

# Logging
LOG_LEVEL=info

# Ngrok Tunnel (opcional - expÃµe API local para webhooks)
# Obtenha seu authtoken em: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_ENABLED=false
NGROK_AUTHTOKEN=
NGROK_PORT=3000

# OAB Cache em MemÃ³ria (L1 - sempre ativo)
# TTL: tempo em minutos que cada resultado fica em cache
OAB_CACHE_TTL_MINUTES=30

# Monitoramento distribuído (recomendado em múltiplas instâncias)
MONITORING_DISTRIBUTED_LOCK=true

# Rate limit por conta
ACCOUNT_RATE_LIMIT_WINDOW_SECONDS=60
ACCOUNT_RATE_LIMIT_FREE=120
ACCOUNT_RATE_LIMIT_PRO=600
ACCOUNT_RATE_LIMIT_ADMIN=2000

