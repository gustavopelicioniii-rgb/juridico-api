# Environment Configuration Example
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database - Development (SQLite)
DB_DIALECT=sqlite
DB_STORAGE=./data/database.sqlite

# Database - Production (PostgreSQL)
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=juridico_api
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Use this instead of host/port/password when using managed Redis
# REDIS_URL=redis://default:password@host:port

# CORS - origens permitidas separadas por vírgula
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT Authentication (OBRIGATÓRIO em produção)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-different-refresh-secret-change-in-production
JWT_EXPIRES_IN=1h

# DataJud API (CNJ - oficial)
# Registre-se em: https://www.cnj.jus.br/sistemas/datajud/api-publica/
# Em dev sem chave, ativa modo MOCK automaticamente
DATAJUD_API_KEY=
DATAJUD_MOCK=false
# Se true, usa adapters legados (scrapers) ao invés do DataJud
DATAJUD_USE_LEGACY=false

# 2Captcha (apenas se usar adapters legados com CAPTCHA)
TWOCAPTCHA_API_KEY=

# Tribunal API Keys (legacy adapters - opcional)
TJSP_API_KEY=
TJMG_API_KEY=

# Proxy Rotation (optional)
PROXY_ROTATION_ENABLED=false
PROXY_LIST=[]

# Logging
LOG_LEVEL=info

# Ngrok Tunnel (opcional - expõe API local para webhooks)
# Obtenha seu authtoken em: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_ENABLED=false
NGROK_AUTHTOKEN=
NGROK_PORT=3000

# OAB Cache em Memória (L1 - sempre ativo)
# TTL: tempo em minutos que cada resultado fica em cache
OAB_CACHE_TTL_MINUTES=30
