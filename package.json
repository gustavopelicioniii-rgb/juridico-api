{
  "name": "juridico-workspace",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "lint-staged": {
    "minha-api/src/**/*.ts": [
      "cd minha-api && npx eslint --fix src/**/*.ts"
    ],
    "dashboard/src/**/*.{ts,tsx}": [
      "cd dashboard && npx eslint --fix src/**/*.{ts,tsx}"
    ]
  },
  "description": "Sistema completo para monitoramento de processos judiciais brasileiros, com API REST e dashboard administrativo em React.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "cd minha-api && npm run build",
    "start": "cd minha-api && npm run start",
    "dev": "cd minha-api && npm run dev",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavopelicioniii-rgb/juridico-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gustavopelicioniii-rgb/juridico-api/issues"
  },
  "homepage": "https://github.com/gustavopelicioniii-rgb/juridico-api#readme"
}
